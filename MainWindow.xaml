<Window x:Class="Notatka_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notatka_App"
        mc:Ignorable="d"
        Title="Aplikacja Notatek" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>

        <!-- Lista notatek -->
        <ListBox x:Name="NotesListBox" Margin="0,0,15,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding Content}" FontWeight="Bold" TextWrapping="Wrap" FontSize="14" />
                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="11" Foreground="Gray" Margin="0,3,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Panel boczny z przyciskami -->
        <StackPanel Grid.Column="1">
            <Button x:Name="BtnAdd" Content="Dodaj notatkę" Click="BtnAdd_Click" Height="35" Margin="0,0,0,10"/>
            <Button x:Name="BtnSave" Content="Zapisz do pliku" Click="BtnSave_Click" Height="35"/>
        </StackPanel>
    </Grid>
</Window>